{
  "version": 2,
  "brand": "Aham",
  "brandSlug": "aham",
  "systemVersion": "7.1.0",
  "readingOrder": [
    {
      "file": "tokens.json",
      "priority": 1,
      "purpose": "唯一数值事实源"
    },
    {
      "file": "DESIGN.md",
      "priority": 2,
      "purpose": "规则与介质选择"
    },
    {
      "file": "WORKBENCH.md",
      "priority": 3,
      "purpose": "网页工作台和高密度单据规则"
    },
    {
      "file": "components/index.json",
      "priority": 4,
      "purpose": "索引；components/{slug}.json 是意图和行为契约"
    },
    {
      "file": "AGENTS.md",
      "priority": 5,
      "purpose": "消费检查清单"
    },
    {
      "file": "aham-ui.css",
      "priority": 6,
      "purpose": "既有参考实现"
    },
    {
      "file": "workbench.css",
      "priority": 7,
      "purpose": "显式选择工作台时加载；不覆盖全局组件"
    },
    {
      "file": "workbench.js",
      "priority": 7,
      "purpose": "工作台外框行为：导航开关（⌘B）、窄屏浮层、侧面板开关；原生 ES 模块"
    },
    {
      "file": "examples/crm-quotation.html",
      "priority": 8,
      "purpose": "可运行的虚构单据示例"
    },
    {
      "file": "examples/workbench-shell.html",
      "priority": 8,
      "purpose": "外框与两条页眉横条、宽侧面板的示例"
    }
  ],
  "componentResolution": {
    "priority": [
      "components/{slug}.json",
      "preview/component-{slug}.html"
    ],
    "previewFirst": false,
    "contractForIntent": true
  },
  "tokenSource": {
    "understanding": "tokens.json",
    "workbenchRuntime": "workbench-tokens.css",
    "legacyRuntime": "colors_and_type.css"
  },
  "legacy": {
    "css.json": "兼容镜像，不是规范源；未纳入新的生成链。",
    "colors_and_type.css": "既有组件别名；工作台使用独立生成文件。"
  },
  "conflictPolicy": "tokens > DESIGN / WORKBENCH > contracts > runtime > examples；发现冲突修复下游，不反推规范。"
}
