{
  "$meta": {
    "name": "Aham UI",
    "version": "9.0.0",
    "$description": "全部取值的唯一来源。每个取值的键名就是 CSS 变量名：键 row 生成 --wb-row。scripts/build.mjs 读本文件生成 aham.css。规则见 rules/2-视觉.md。"
  },
  "color": {
    "$description": "颜色分四组：中性色（底色、线、文字）、主色、状态色、分类色。用途范围见 rules/2-视觉.md 第 1 节。亮色和暗色键名相同，暗色单独取值，不由亮色推算。",
    "light": {
      "bg": {
        "$value": "#FFFFFF",
        "$description": "内容区底色"
      },
      "canvas": {
        "$value": "#EDECEB",
        "$description": "外框、侧栏、打印预览的底色。9.0 按 Claude 客户端侧栏取色（#EDECEB，几乎不带色相），比内容区深一档"
      },
      "fill": {
        "$value": "#F3F3F3",
        "$description": "一行高的小元素底色：分段按钮、评论、标签底、禁用输入框。高度超过一行的区域不用"
      },
      "hover": {
        "$value": "#F3F3F2",
        "$description": "悬停"
      },
      "selected": {
        "$value": "#EBEBEA",
        "$description": "选中项、勾选行"
      },
      "nav-hover": {
        "$value": "#E3E2E0",
        "$description": "侧栏导航项的悬停，比当前项浅一档"
      },
      "nav-selected": {
        "$value": "#D5D4D3",
        "$description": "侧栏的当前项和按下。按 Claude 客户端侧栏当前项取色"
      },
      "line": {
        "$value": "#E5E5E4",
        "$description": "分隔线"
      },
      "edge": {
        "$value": "#D6D5D3",
        "$description": "工作面和外框的交界线。比分栏线深一档，让内容区像一块面板"
      },
      "line-soft": {
        "$value": "#EFEFEE",
        "$description": "行与行之间的线：单行列表、设置行、属性行。比分栏线浅一档"
      },
      "line-strong": {
        "$value": "#80807E",
        "$description": "输入框和按钮的描边，对白底 3.96:1、对外框底色 3.35:1，达到 WCAG 对控件边界的 3:1"
      },
      "pop-bg": {
        "$value": "#FFFFFF",
        "$description": "浮层底色"
      },
      "ink": {
        "$value": "#151515",
        "$description": "正文"
      },
      "ink-2": {
        "$value": "#525251",
        "$description": "字段标签、次要文字，7.82:1"
      },
      "muted": {
        "$value": "#666664",
        "$description": "次要文字、辅助说明、占位文字、空值、表头，5.75:1"
      },
      "faint": {
        "$value": "#888886",
        "$description": "只用于图标和禁用文字，3.55:1，不用于需要读的文字"
      },
      "blue": {
        "$value": "#336EE8",
        "$description": "主色：主按钮、焦点框、当前项标记、进行中的阶段图标。正文链接不用主色"
      },
      "blue-bg": {
        "$value": "#EDF1FA",
        "$description": "主色浅底：信息消息条"
      },
      "action": {
        "$value": "#164EC3",
        "$description": "主按钮底色，白字 7.21:1"
      },
      "action-hover": {
        "$value": "#1243A8",
        "$description": "主按钮悬停，比静止深一档"
      },
      "action-press": {
        "$value": "#0F3891",
        "$description": "主按钮按下，再深一档"
      },
      "on": {
        "$value": "#FFFFFF",
        "$description": "主按钮文字"
      },
      "success": {
        "$value": "#1F7A4D",
        "$description": "成功：已生效、已完成、通过"
      },
      "success-bg": {
        "$value": "#EAF4EE"
      },
      "warning": {
        "$value": "#A15C07",
        "$description": "警示：待处理、将到期、可保存但要注意"
      },
      "warning-bg": {
        "$value": "#FBF2E4"
      },
      "warning-mark": {
        "$value": "#F5E4C6",
        "$description": "要核对的值的文字底色"
      },
      "danger": {
        "$value": "#B42318",
        "$description": "错误：校验失败、已驳回、逾期、删除"
      },
      "danger-bg": {
        "$value": "#FBEBE9"
      },
      "info": {
        "$value": "#336EE8",
        "$description": "信息：处理中、审批中"
      },
      "info-bg": {
        "$value": "#EDF1FA"
      },
      "cat-1": {
        "$value": "#336EE8",
        "$description": "分类色 1 蓝"
      },
      "cat-2": {
        "$value": "#0F7B7B",
        "$description": "分类色 2 青"
      },
      "cat-3": {
        "$value": "#3B7D35",
        "$description": "分类色 3 绿"
      },
      "cat-4": {
        "$value": "#B25E09",
        "$description": "分类色 4 琥珀"
      },
      "cat-5": {
        "$value": "#C4421A",
        "$description": "分类色 5 橙红"
      },
      "cat-6": {
        "$value": "#6E56CF",
        "$description": "分类色 6 紫"
      },
      "scrim": {
        "$value": "rgba(0,0,0,0.4)",
        "$description": "模态弹窗的遮罩。按 Claude 客户端设置弹窗实测，约等于黑色 40%"
      }
    },
    "dark": {
      "bg": {
        "$value": "#151515"
      },
      "canvas": {
        "$value": "#0B0B0B"
      },
      "fill": {
        "$value": "#20201F"
      },
      "hover": {
        "$value": "#20201F"
      },
