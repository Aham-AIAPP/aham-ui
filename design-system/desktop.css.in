/* Aham PC profile. Values are generated from tokens.json. See DESKTOP.md. */
.aham-workbench.wb-pc { --wb-page-gutter: var(--wb-pc-gutter); }
.aham-workbench.wb-pc .wb-page-head { padding: var(--wb-s5) var(--wb-page-gutter) var(--wb-s4); gap: var(--wb-s5); }
.aham-workbench.wb-pc .wb-page-head-lead { flex: 1; min-width: 0; gap: var(--wb-s2) var(--wb-s3); }
.aham-workbench.wb-pc .wb-page-head-lead h1 { flex-basis: 100%; min-width: 0; font-size: var(--wb-detail-title); font-weight: 600; line-height: 1.35; }
.aham-workbench.wb-pc .wb-page-head-trail { flex: none; gap: var(--wb-s2); }
.aham-workbench.wb-pc .wb-document { padding: var(--wb-s5) var(--wb-page-gutter) var(--wb-s7); container-type: inline-size; }
.aham-workbench.wb-pc .wb-section-head { margin-block-end: var(--wb-s4); }
.aham-workbench.wb-pc .wb-section-head h2 { font-size: var(--wb-text-base); font-weight: 600; }
.aham-workbench.wb-pc .wb-table-scroll { border: 1px solid var(--wb-line); border-radius: var(--wb-radius); scrollbar-width: thin; scrollbar-color: var(--wb-line) transparent; }
.aham-workbench.wb-pc .wb-table thead th { height: var(--wb-pc-table-head); background: var(--wb-panel); font-size: var(--wb-text-sm); box-shadow: inset 0 -1px var(--wb-line); }
.aham-workbench.wb-pc .wb-table:not(.wb-list-table) { --wb-row: var(--wb-touch); }
.aham-workbench.wb-pc .wb-table tbody:last-child tr:last-child > td { border-bottom: 0; }
.aham-workbench.wb-pc .wb-table:not(.wb-tree-table) :is(th, td) { padding-inline: var(--wb-s3); }
.aham-workbench.wb-pc .wb-search { height: var(--wb-hit); }
.aham-workbench.wb-pc .wb-settings { max-width: var(--wb-pc-form-max); padding: var(--wb-s5) var(--wb-page-gutter) var(--wb-s8); margin-inline: 0; }
.aham-workbench.wb-pc .wb-settings > h1 { font-weight: 600; line-height: 1.35; }
.aham-workbench.wb-pc .wb-settings-section > header { margin-block-end: var(--wb-s4); }
.aham-workbench.wb-pc .wb-settings-section h2 { font-weight: 600; }
.aham-workbench.wb-pc .wb-setting { padding-block: var(--wb-s4); }
.aham-workbench.wb-pc .wb-setting-desc { font-size: var(--wb-text-sm); line-height: 1.6; }
/* Shared form layout can be consumed independently of a framework. */
.aham-workbench.wb-pc .wb-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--wb-s4) var(--wb-s5); max-width: var(--wb-pc-form-max); margin: 0; }
.aham-workbench.wb-pc .wb-form-field { display: flex; flex-direction: column; gap: var(--wb-s2); min-width: 0; align-items: stretch; }
.aham-workbench.wb-pc .wb-form-field > label { color: var(--wb-muted); font-size: var(--wb-body); line-height: 20px; }
.aham-workbench.wb-pc .wb-form-full { grid-column: 1 / -1; }
.aham-workbench.wb-pc .wb-form-hint { color: var(--wb-muted); font-size: var(--wb-text-sm); line-height: 1.6; }
.aham-workbench.wb-pc .wb-form-error { color: var(--wb-danger); font-size: var(--wb-text-sm); line-height: 1.6; }
.aham-workbench.wb-pc .wb-form-field :is(input:not([type=checkbox],[type=radio]),select) { width: 100%; min-width: 0; height: var(--wb-hit); margin: 0; padding-inline: var(--wb-s3); border: 1px solid var(--wb-line); border-radius: var(--wb-radius); background: var(--wb-bg); color: var(--wb-ink); font: inherit; }
.aham-workbench.wb-pc .wb-form-field :is(input,select,textarea):focus-visible { outline: var(--focus-ring-w) solid var(--wb-blue); outline-offset: var(--focus-ring-offset); }
.aham-workbench.wb-pc .wb-form-field [aria-invalid=true] { border-color: var(--wb-danger); }
@container (max-width: {{workbench.desktop.formBreakpoint}}) {
  .aham-workbench.wb-pc .wb-form-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (min-width: {{workbench.desktop.wideBreakpoint}}) {
  .aham-workbench.wb-pc { --wb-page-gutter: var(--wb-pc-wide-gutter); }
}

/* 单位参与布局，避免长单位与右对齐数值重叠。 */
.aham-workbench.wb-pc .input-wrap.has-suffix { display: inline-flex; align-items: center; height: var(--wb-hit); border: 1px solid var(--wb-line); border-radius: var(--wb-radius); background: var(--wb-bg); }
.aham-workbench.wb-pc .input-wrap.has-suffix:hover { border-color: var(--wb-muted); }
.aham-workbench.wb-pc .input-wrap.has-suffix:focus-within { border-color: var(--wb-blue); box-shadow: 0 0 0 3px var(--focus-ring); }
.aham-workbench.wb-pc .input-wrap.has-suffix:has([aria-invalid=true]) { border-color: var(--wb-danger); }
.aham-workbench.wb-pc .input-wrap.has-suffix .input { flex: 1; width: 0; min-width: 0; height: 100%; padding-inline: var(--wb-s3) var(--wb-s2); border: 0; background: transparent; box-shadow: none; outline: 0; }
.aham-workbench.wb-pc .input-wrap.has-suffix .affix.suf { position: static; flex: none; padding-inline-end: var(--wb-s3); white-space: nowrap; font-size: var(--wb-text-sm); color: var(--wb-muted); }

.aham-workbench.wb-pc .wb-form-grid.is-reading .wb-form-field { display: grid; grid-template-columns: var(--wb-pc-label) minmax(0, 1fr); gap: var(--wb-s4); align-items: baseline; }
