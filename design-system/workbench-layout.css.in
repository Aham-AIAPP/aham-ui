/* Breakpoints are substituted from canonical tokens; CSS variables do not work in media conditions. */
@media (max-width: {{workbench.formBreakpoint}}) {
 .aham-workbench .wb-fields {grid-template-columns:repeat(2,minmax(0,1fr))}
}
/* ≤ context breakpoint: full-bleed card, one scroll column, summary after the document, nav opens as an overlay. */
@media (max-width: {{workbench.contextBreakpoint}}) {
 .aham-workbench .wb-main {margin:0;border-radius:0}
 .aham-workbench .wb-layout {display:block;overflow:auto}
 .aham-workbench .wb-layout>.wb-document {overflow:visible}
 .aham-workbench .wb-panel {width:auto;overflow:visible;border-inline-start:0}
 .aham-workbench .wb-context {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--wb-s5)}
 .aham-workbench.expanded {grid-template-columns:var(--wb-rail) minmax(0,1fr)}
 .aham-workbench.expanded .wb-rail {position:fixed;inset-block:0;inset-inline-start:0;z-index:var(--wb-z-nav);width:var(--wb-nav);box-shadow:var(--wb-shadow-float)}
 .aham-workbench .wb-layout.is-list {display:grid;overflow:hidden}
 .aham-workbench .wb-detail {display:block;overflow:auto}
 .aham-workbench .wb-detail-scroll {overflow:visible}
 .aham-workbench .wb-detail>.wb-panel {border-top:1px solid var(--wb-line)}
 .aham-workbench .wb-panel[data-size=wide] {position:fixed;inset-block:0;inset-inline-end:0;z-index:var(--wb-z-nav);width:min(var(--wb-panel-wide),100vw);overflow:auto;box-shadow:var(--wb-shadow-float)}
}
/* ≤ mobile breakpoint: normal page flow; the rail is hidden until the header toggle opens it. */
@media (max-width: {{workbench.mobileBreakpoint}}) {
 .aham-workbench,.aham-workbench.expanded {display:block;height:auto;min-height:100vh;overflow:visible;background:var(--wb-bg)}
 .aham-workbench .wb-rail {display:none}
 .aham-workbench.expanded .wb-rail {display:flex}
 .aham-workbench .wb-main {overflow:visible}
 .aham-workbench .wb-layout {overflow:visible}
 .aham-workbench .wb-fields,.aham-workbench .wb-context,.aham-workbench .wb-doc-notes {grid-template-columns:1fr}
 .aham-workbench .wb-page-head,.aham-workbench .wb-tabs-bar {flex-wrap:wrap}
 .aham-workbench .wb-header-row {height:auto;min-height:var(--wb-header-row);flex-wrap:wrap;padding-block:var(--wb-s1)}
 .aham-workbench .wb-header-lead {flex-wrap:wrap}
 .aham-workbench .wb-crumbs {flex:1 1 calc(100% - var(--wb-touch) - var(--wb-s2));flex-wrap:wrap;white-space:normal}
 .aham-workbench .wb-crumbs>* {white-space:nowrap}
 .aham-workbench .wb-seg.sm {height:auto}
 .aham-workbench .wb-crumbs-meta {display:none}
 .aham-workbench .wb-tabs {gap:var(--wb-s3)}
 .aham-workbench button,.aham-workbench input:not([type=checkbox],[type=radio]) {min-height:var(--wb-touch)}
 .aham-workbench input,.aham-workbench textarea {font-size:var(--wb-s4)}
 .aham-workbench .wb-table {min-width:calc(var(--wb-table-min) + var(--wb-s8))}
 .aham-workbench .wb-layout.is-list {display:block;overflow:visible}
 .aham-workbench .wb-detail {overflow:visible}
 .aham-workbench .wb-detail-main {padding:var(--wb-s4)}
 .aham-workbench .wb-pager {flex-wrap:wrap;padding-block:var(--wb-s2)}
 .aham-workbench .wb-search {width:auto;flex:1}
 .aham-workbench .wb-filter-bar {align-items:center}
 .aham-workbench .wb-filter-chips {flex-wrap:nowrap;overflow-x:auto}
 .aham-workbench .wb-chip {flex:none;height:var(--wb-touch)}
 .aham-workbench .wb-chip-remove {width:var(--wb-touch)}
 .aham-workbench {--wb-check-col:var(--wb-touch)}
 .aham-workbench .wb-list-table td {height:var(--wb-touch)}
 .aham-workbench .wb-check-hit {min-height:calc(var(--wb-touch) - 1px)}
}
@media (pointer:coarse) {
 .aham-workbench button,.aham-workbench input:not([type=checkbox],[type=radio]) {min-height:var(--wb-touch);min-width:var(--wb-touch)}
 .aham-workbench {--wb-check-col:var(--wb-touch)}
 .aham-workbench .wb-list-table td {height:var(--wb-touch)}
 .aham-workbench .wb-check-hit {min-height:calc(var(--wb-touch) - 1px)}
 .aham-workbench .wb-seg.sm {height:auto}
 .aham-workbench .wb-chip {height:var(--wb-touch)}
 .aham-workbench .wb-chip-remove {width:var(--wb-touch)}
 .aham-workbench input,.aham-workbench textarea {font-size:var(--wb-s4)}
}
