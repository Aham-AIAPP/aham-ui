    "worklog": "<div class=\"wb-worklog-open\" aria-label=\"待处理任务\"><div class=\"wb-worklog-task is-overdue\"><span class=\"wb-worklog-due\">10-26 · 已逾期</span><span class=\"wb-worklog-goal\"><b>约王卓评审方案初稿</b><small>林悦 · TASK-0187</small></span><span class=\"wb-worklog-actions\"><button type=\"button\" class=\"wb-btn sm\">处理</button></span></div></div><ol class=\"wb-worklog\"><li class=\"wb-worklog-item is-strong\"><div class=\"wb-worklog-meta\"><b>上门拜访</b><span class=\"wb-worklog-tag\">方案沟通</span><span>2026-10-09 14:00</span><span>林悦</span><a class=\"wb-worklog-code\" href=\"#\">OPFU-0388</a></div><div class=\"wb-worklog-body\">参观三个车间。</div><div class=\"wb-worklog-note is-next\"><span>下一步 · 10-30</span>约王卓评审方案初稿</div><div class=\"wb-worklog-closed\">同时完成任务 TASK-0168</div><details class=\"wb-worklog-detail\"><summary>完整内容</summary></details><div class=\"wb-worklog-extra\"><b>推荐企业</b></div></li></ol><details class=\"wb-worklog-more\"><summary>查看更早记录 · 3 条</summary></details>"
