{
  "$meta": {
    "name": "Aham UI",
    "version": "8.1.0",
    "$description": "全部取值的唯一来源。每个取值的键名就是 CSS 变量名：键 row 生成 --wb-row。scripts/build.mjs 读本文件生成 aham.css。规则见 rules/2-视觉.md。"
  },
  "color": {
    "$description": "颜色分四组：中性色（底色、线、文字）、主色、状态色、分类色。用途范围见 rules/2-视觉.md 第 1 节。亮色和暗色键名相同，暗色单独取值，不由亮色推算。",
    "light": {
      "bg": {
        "$value": "#FFFFFF",
        "$description": "内容区底色"
      },
      "canvas": {
        "$value": "#F9F9F7",
        "$description": "外框、导航栏、打印预览的底色。和内容区只差约 2% 亮度，参考 Claude 客户端的 surface-0"
      },
      "fill": {
        "$value": "#F3F3F0",
        "$description": "一行高的小元素底色：分段按钮、评论、标签底、禁用输入框。高度超过一行的区域不用"
      },
      "hover": {
        "$value": "#F3F3F0",
        "$description": "悬停"
      },
      "selected": {
        "$value": "#EDECE8",
        "$description": "选中项、勾选行"
      },
      "line": {
        "$value": "#EAE9E4",
        "$description": "分隔线"
      },
      "line-strong": {
        "$value": "#8C8880",
        "$description": "输入框和按钮的描边，对白底 3.53:1，达到 WCAG 对控件边界的 3:1"
      },
      "pop-bg": {
        "$value": "#FFFFFF",
        "$description": "浮层底色"
      },
      "ink": {
        "$value": "#151515",
        "$description": "正文"
      },
      "ink-2": {
        "$value": "#52514E",
        "$description": "字段标签、次要文字，7.94:1"
      },
      "muted": {
        "$value": "#6D6B67",
        "$description": "次要文字、辅助说明、占位文字、空值、表头，5.32:1"
      },
      "faint": {
        "$value": "#898781",
        "$description": "只用于图标和禁用文字，3.59:1，不用于需要读的文字"
      },
      "blue": {
        "$value": "#336EE8",
        "$description": "主色：链接、焦点、当前页签、信息"
      },
      "blue-bg": {
        "$value": "#EDF1FA",
        "$description": "主色浅底：信息消息条"
      },
      "action": {
        "$value": "#164EC3",
        "$description": "主按钮底色，白字 7.21:1"
      },
      "action-hover": {
        "$value": "#336EE8",
        "$description": "主按钮悬停"
      },
      "on": {
        "$value": "#FFFFFF",
        "$description": "主按钮文字"
      },
      "success": {
        "$value": "#1F7A4D",
        "$description": "成功：已生效、已完成、通过"
      },
      "success-bg": {
        "$value": "#EAF4EE"
      },
      "warning": {
        "$value": "#A15C07",
        "$description": "警示：待处理、将到期、可保存但要注意"
      },
      "warning-bg": {
        "$value": "#FBF2E4"
      },
      "warning-mark": {
        "$value": "#F5E4C6",
        "$description": "要核对的值的文字底色"
      },
      "danger": {
        "$value": "#B42318",
        "$description": "错误：校验失败、已驳回、逾期、删除"
      },
      "danger-bg": {
        "$value": "#FBEBE9"
      },
      "info": {
        "$value": "#336EE8",
        "$description": "信息：处理中、审批中"
      },
      "info-bg": {
        "$value": "#EDF1FA"
      },
      "cat-1": {
        "$value": "#336EE8",
        "$description": "分类色 1 蓝"
      },
      "cat-2": {
        "$value": "#0F7B7B",
        "$description": "分类色 2 青"
      },
      "cat-3": {
        "$value": "#3B7D35",
        "$description": "分类色 3 绿"
      },
      "cat-4": {
        "$value": "#B25E09",
        "$description": "分类色 4 琥珀"
      },
      "cat-5": {
        "$value": "#C4421A",
        "$description": "分类色 5 橙红"
      },
      "cat-6": {
        "$value": "#6E56CF",
        "$description": "分类色 6 紫"
      },
      "scrim": {
        "$value": "rgba(38,37,34,0.28)",
        "$description": "弹窗遮罩"
      }
    },
    "dark": {
      "bg": {
        "$value": "#151515"
      },
      "canvas": {
        "$value": "#0B0B0B"
      },
      "fill": {
        "$value": "#20201F"
      },
      "hover": {
        "$value": "#20201F"
      },
      "selected": {
        "$value": "#2C2C2A"
      },
      "line": {
        "$value": "#2A2A28"
      },
      "line-strong": {
        "$value": "#6E6C66"
      },
      "pop-bg": {
        "$value": "#1A1A19"
      },
      "ink": {
        "$value": "#F5F5F3"
      },
      "ink-2": {
        "$value": "#C3C2B7"
      },
      "muted": {
        "$value": "#A5A49A"
      },
      "faint": {
        "$value": "#7B7974"
      },
      "blue": {
        "$value": "#6C97F0"
      },
      "blue-bg": {
        "$value": "#1F2A40"
      },
      "action": {
        "$value": "#336EE8"
      },
      "action-hover": {
        "$value": "#4A7FEB"
      },
      "on": {
        "$value": "#FFFFFF"
      },
      "success": {
        "$value": "#6DBE8F"
      },
      "success-bg": {
        "$value": "#1C2A22"
      },
      "warning": {
        "$value": "#E0A84A"
      },
      "warning-bg": {
        "$value": "#2E2617"
      },
      "warning-mark": {
        "$value": "#4A3B1F"
      },
      "danger": {
        "$value": "#F08A7E"
      },
      "danger-bg": {
        "$value": "#33201D"
      },
      "info": {
        "$value": "#7EA4F2"
      },
      "info-bg": {
        "$value": "#1F2A40"
      },
      "cat-1": {
        "$value": "#7EA4F2"
      },
      "cat-2": {
        "$value": "#4FB8B8"
      },
      "cat-3": {
        "$value": "#7DBB75"
      },
      "cat-4": {
        "$value": "#E0A84A"
      },
      "cat-5": {
        "$value": "#F08A6A"
      },
      "cat-6": {
        "$value": "#A797F0"
      },
      "scrim": {
        "$value": "rgba(0,0,0,0.5)"
      }
    },
    "contrast-more": {
      "$description": "系统开启增强对比度时的覆盖值，控件边界达到 3:1",
      "line-more": {
        "$value": "#8C8880"
      },
      "muted-more": {
        "$value": "#4A4743"
      },
      "line-more-dark": {
        "$value": "#7A766F"
      }
    }
  },
  "font": {
    "$description": "无衬线用 Inter Variable（随包附带，SIL OFL），中文回退微软雅黑、苹方；等宽用 JetBrains Mono 系列。只用无衬线和等宽两种字族。",
    "font": {
      "$value": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', system-ui, sans-serif"
    },
    "mono": {
      "$value": "'JetBrains Mono', 'SF Mono', ui-monospace, Menlo, Consolas, monospace"
    },
    "font-features": {
      "$value": "'cv01', 'ss03'",
      "$description": "Inter 的字形特性：数字 1 的替代字形、圆形引号；等宽处关闭"
    }
  },
  "text": {
    "$description": "字号。界面正文 13px，最小 12px。层级靠字号和字重，字重只用 400、500、600。",
    "text-xs": {
      "$value": "12px",
      "$description": "辅助说明、角标、表格副行"
    },
    "text-sm": {
      "$value": "13px"
    },
    "body": {
      "$value": "13px",
      "$description": "界面正文、表格、表单"
    },
    "text-base": {
      "$value": "14px",
      "$description": "分区标题、弹窗标题"
    },
    "title": {
      "$value": "20px",
      "$description": "列表页、设置页标题"
    },
    "detail-title": {
      "$value": "24px",
      "$description": "单据和记录的标题"
    },
    "total": {
      "$value": "24px",
      "$description": "摘要栏合计金额"
    },
    "touch-input": {
      "$value": "16px",
      "$description": "触屏输入字号，防止手机浏览器自动放大"
    }
  },
  "space": {
    "$description": "间距，4 的倍数。留白是首要分隔，先加间距再考虑加线。",
    "s0": {
      "$value": "0"
    },
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "24px"
    },
    "s6": {
      "$value": "32px"
    },
    "s7": {
      "$value": "48px"
    },
    "s8": {
      "$value": "64px"
    },
    "s9": {
      "$value": "96px"
    }
  },
  "radius": {
    "$description": "圆角三档加胶囊。胶囊只用于开关、头像、计数和进度条。",
    "radius-sm": {
      "$value": "4px",
      "$description": "标签、键帽、勾选框、行内标记"
    },
    "radius": {
      "$value": "8px",
      "$description": "按钮、输入框、下拉、弹层、表格外框"
    },
    "radius-lg": {
      "$value": "12px",
      "$description": "弹窗、命令面板、上传区"
    },
    "shell-radius": {
      "$value": "10px",
      "$description": "内容区外壳"
    },
    "radius-pill": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$description": "静置和悬停无阴影，只有浮层有阴影。浮层阴影带 1px 描边。",
    "shadow-pop": {
      "$value": "0 0 0 1px rgba(20,20,20,0.08), 0 2px 6px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.10)",
      "$description": "菜单、下拉、提示"
    },
    "shadow-float": {
      "$value": "0 0 0 1px rgba(20,20,20,0.08), 0 4px 8px rgba(0,0,0,0.06), 0 12px 28px rgba(0,0,0,0.10)",
      "$description": "弹窗、抽屉"
    }
  },
  "size": {
    "$description": "控件和行高。默认档行高 36px，紧凑档 32px；44px 只在触屏和窄屏使用（pointer: coarse 或宽度 ≤ 640px）。",
    "row": {
      "$value": "36px",
      "$description": "表格行、列表行、表头的默认高度"
    },
    "row-compact": {
      "$value": "32px",
      "$description": "紧凑档行高"
    },
    "row-double": {
      "$value": "48px",
      "$description": "带副行的两行行高"
    },
    "control": {
      "$value": "32px",
      "$description": "按钮、输入框、下拉的默认高度"
    },
    "header-control": {
