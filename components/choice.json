    ".wb-choice"
  ],
  "markup": {
    "radio": "<span class=\"wb-choices\" role=\"radiogroup\" aria-labelledby=\"l-tax\"><label class=\"wb-choice\"><input type=\"radio\" name=\"tax\" value=\"含税\">含税</label><label class=\"wb-choice\"><input type=\"radio\" name=\"tax\" value=\"不含税\">不含税</label></span>"
  },
  "states": [
    "checked",
    "unchecked",
    "disabled",
    "focus-visible"
