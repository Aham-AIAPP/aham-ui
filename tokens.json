      },
      "line": {
        "$value": "#2A2A28"
      },
      "edge": {
        "$value": "#343432"
      },
      "line-soft": {
        "$value": "#1F1F1E"
      },
      "line-strong": {
        "$value": "#6E6C66"
      },
      "pop-bg": {
        "$value": "#1A1A19"
      },
      "ink": {
        "$value": "#F5F5F3"
      },
      "ink-2": {
        "$value": "#C3C2B7"
      },
      "muted": {
        "$value": "#A5A49A"
      },
      "faint": {
        "$value": "#7B7974"
      },
      "blue": {
        "$value": "#6C97F0"
      },
      "blue-bg": {
        "$value": "#1F2A40"
      },
      "action": {
        "$value": "#336EE8"
      },
      "action-hover": {
        "$value": "#2A62D6"
      },
      "action-press": {
        "$value": "#2357C4"
      },
      "on": {
        "$value": "#FFFFFF"
      },
      "success": {
        "$value": "#6DBE8F"
      },
      "success-bg": {
        "$value": "#1C2A22"
      },
      "warning": {
        "$value": "#E0A84A"
      },
      "warning-bg": {
        "$value": "#2E2617"
      },
      "warning-mark": {
        "$value": "#4A3B1F"
      },
      "danger": {
        "$value": "#F08A7E"
      },
      "danger-bg": {
        "$value": "#33201D"
      },
      "info": {
        "$value": "#7EA4F2"
      },
      "info-bg": {
        "$value": "#1F2A40"
      },
      "cat-1": {
        "$value": "#7EA4F2"
      },
      "cat-2": {
        "$value": "#4FB8B8"
      },
      "cat-3": {
        "$value": "#7DBB75"
      },
      "cat-4": {
        "$value": "#E0A84A"
      },
      "cat-5": {
        "$value": "#F08A6A"
      },
      "cat-6": {
        "$value": "#A797F0"
      },
      "scrim": {
        "$value": "rgba(0,0,0,0.5)"
      }
    },
    "contrast-more": {
      "$description": "系统开启增强对比度时的覆盖值，控件边界达到 3:1",
      "line-more": {
        "$value": "#767674"
      },
      "muted-more": {
        "$value": "#474746"
      },
      "line-more-dark": {
        "$value": "#7A766F"
      }
    }
  },
  "font": {
    "$description": "无衬线用 Inter Variable（随包附带，SIL OFL），中文回退苹方、微软雅黑；数字和编号用 Inter 的等宽数字。等宽字体 JetBrains Mono 只用于代码。",
    "font": {
      "$value": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', system-ui, sans-serif"
    },
    "mono": {
      "$value": "'JetBrains Mono', 'SF Mono', ui-monospace, Menlo, Consolas, monospace"
    },
    "font-features": {
      "$value": "'cv01', 'ss03'",
      "$description": "Inter 的字形特性：数字 1 的替代字形、圆形引号；等宽处关闭"
    }
  },
  "text": {
    "$description": "字号。工作台一屏只用 13px 和 12px 两档，20px 标题一页一次，最小 12px。层级先靠颜色，再靠字重 400、500，600 只给标题。",
    "text-xs": {
      "$value": "12px",
      "$description": "辅助信息：分组名、计数、属性栏标签、日期等元数据"
    },
    "text-sm": {
      "$value": "13px"
    },
    "body": {
      "$value": "13px",
      "$description": "界面正文、列表、表格、表单、页眉标题、侧栏"
    },
    "text-base": {
      "$value": "14px",
      "$description": "弹窗标题；对外填报页正文"
    },
    "title": {
      "$value": "20px",
      "$description": "详情页、单据页、设置页标题和打印件标题，一页一次"
    },
    "total": {
      "$value": "24px",
      "$description": "摘要栏合计金额"
    },
    "touch-input": {
      "$value": "16px",
      "$description": "触屏输入字号，防止手机浏览器自动放大"
    }
  },
  "space": {
    "$description": "间距，4 的倍数。留白是首要分隔，先加间距再考虑加线。",
    "s0": {
      "$value": "0"
    },
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "24px"
    },
    "s6": {
      "$value": "32px"
    },
    "s7": {
      "$value": "48px"
    },
    "s8": {
      "$value": "64px"
    },
    "s9": {
      "$value": "96px"
    }
  },
  "radius": {
    "$description": "圆角三档加胶囊。胶囊只用于开关、头像、计数和进度条。",
    "radius-sm": {
      "$value": "4px",
      "$description": "标签、键帽、勾选框、行内标记"
    },
    "radius": {
      "$value": "8px",
      "$description": "按钮、输入框、下拉、弹层、表格外框"
    },
    "radius-lg": {
      "$value": "12px",
      "$description": "弹窗、命令面板、上传区"
    },
    "radius-pill": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$description": "静置和悬停无阴影，只有浮层有阴影。浮层阴影带 1px 描边。",
    "shadow-pop": {
      "$value": "0 0 0 1px rgba(20,20,20,0.08), 0 2px 6px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.10)",
      "$description": "菜单、下拉、提示"
    },
    "shadow-float": {
      "$value": "0 0 0 1px rgba(20,20,20,0.08), 0 4px 8px rgba(0,0,0,0.06), 0 12px 28px rgba(0,0,0,0.10)",
