  "rules": [
    "站点写阶段名和一行说明：进站日期、停留天数、建议天数或计划日期",
    "当前阶段那一段拉长到其他段的 3 倍",
    "面对面的记录用实心点 .is-strong，其他用空心点；点可以链接到那条记录",
    "挤不下的日期只画点，悬停看日期和内容",
    "位置只用 .wb-at-N / .wb-fill-N 档位类，不写内联样式",
    "最少 680px 宽，窄屏横向滚动"
  ],
  "accessibility": [
    "轨道写 role=\"img\" 和 aria-label：当前阶段和记录条数",
    "每个点在 .sr-only 里写日期和内容"
  ],
  "doNotInvent": [
    "用分类色给阶段上色",
    "把关键信息里的数字再画到阶段条上",
    "点上写长文本"
  ]
