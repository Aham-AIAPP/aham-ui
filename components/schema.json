{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components/schema.json",
  "title": "Aham UI 组件契约",
  "description": "每份 components/*.json 的结构。scripts/contracts.mjs 按它校验，并核对类名、导出名、条文锚点和示例页。",
  "type": "object",
  "required": ["slug", "name", "schemaVersion", "implementation", "intent", "specification", "rules", "doNotInvent"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "description": "和文件名相同" },
    "name": { "type": "string" },
    "schemaVersion": { "type": "number", "enum": [3] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "implementation": { "type": "string", "enum": ["aham.css"] },
    "behavior": { "type": "string", "description": "行为所在：aham.js，或 examples/ 下的样板脚本" },
    "sample": { "type": "boolean", "description": "api 只在样板里实现，aham.js 没有导出" },
    "preview": { "type": "string", "description": "示例页路径" },
    "reference": { "type": "string", "description": "完整用法所在的示例页" },
    "intent": { "type": "string" },
    "specification": { "type": "string", "description": "rules/ 里的条文，带锚点" },
    "api": { "type": ["string", "object"], "description": "调用写法；对象时每个键是一个函数" },
    "classes": { "type": "array", "items": { "type": "string" } },
    "markup": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "keyboard": { "type": ["array", "object"] },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "doNotInvent": { "type": "array", "items": { "type": "string" } },
    "variantDimensions": { "type": "array", "items": { "type": "object", "required": ["axis", "values"] } },
    "anatomy": { "type": "object" },
    "itemSchema": { "type": "string" },
    "fieldSchema": { "type": "string" },
    "operators": { "type": "object" },
    "reserved": { "type": "object" },
    "lifecycle": { "type": "array", "description": "状态清单：每个状态能改哪些字段、有哪些操作、下一步提示条怎么写", "items": { "type": "object", "required": ["status", "editable", "actions", "next"], "additionalProperties": false, "properties": { "status": { "type": "string" }, "editable": { "type": ["boolean", "array"] }, "actions": { "type": "array", "items": { "type": "string" } }, "next": { "type": "string" } } } },
    "visibility": { "type": "object", "description": "多方共用的对象里每个部分的可见范围：both 双方可见，ours 仅我方，ours-until-confirmed 我方确认前仅我方", "additionalProperties": { "type": "string", "enum": ["both", "ours", "ours-until-confirmed"] } }
  }
}
